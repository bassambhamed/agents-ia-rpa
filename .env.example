# Modèle du fichier .env commun à tous les ateliers de la formation (Modules 01 à 05,
# application du Module 02). Copiez-le en .env à la racine, puis renseignez vos clés :
# le .env ne doit jamais être versionné (il figure dans .gitignore) ni partagé.

# --- Fournisseurs de LLM (paliers gratuits, modèles open-weight) ---
# Groq : https://console.groq.com/keys
# NVIDIA : https://build.nvidia.com (clé « nvapi-… »)
# OpenRouter : https://openrouter.ai/keys (modèles « :free », environ 50 requêtes par jour sans crédit)
# Hugging Face : https://huggingface.co/settings/tokens (Inference Providers : crédits requis)
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# --- Modèles (forme fournisseur:modèle), paliers gratuits vérifiés en octobre 2026 ---
# Agent et ateliers : rapide, appel d'outils et sorties structurées (8 000 tokens par minute, 200 000 par jour)
MODELE_PAR_DEFAUT=groq:openai/gpt-oss-20b
# Juge des évaluations (2.C, 4.B, 4.C) : un autre modèle, chez un autre fournisseur
MODELE_JUGE=nvidia:nvidia/nemotron-3.5-lightning-30b-a3b

# --- Observabilité (facultatif) ---
# Langfuse (atelier 3.D) : https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LangSmith (atelier 2.C et application du Module 02) : https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=assistant-fictiva
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Application du Module 02 (backend FastAPI) ---
RERANKING=true
NOMBRE_EXTRAITS=4
ORIGINES_CORS=http://localhost:3000

# --- Workflow RPA 2.0 du Module 05 ---
# Montant au-delà duquel un remboursement passe en validation humaine
SEUIL_VALIDATION_CHF=1000
# Modèle utilisé si le modèle principal échoue (tri des emails)
MODELE_SECOURS=nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
# Adresse de n8n (facultatif)
N8N_URL=http://127.0.0.1:5678
