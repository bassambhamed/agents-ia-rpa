# Par défaut, les ateliers lisent le .env commun, à la racine de la formation (modèle :
# .env.example à la racine). Ce fichier ne sert que si vous utilisez ce dossier seul :
# un .env placé ici l'emporte sur le .env commun.
#
# Copiez ce fichier en .env (dans le dossier backend), puis renseignez au moins
# une clé de fournisseur.
# Le fichier .env ne doit jamais être partagé ni versionné.

# --- Fournisseurs de LLM (paliers gratuits, modèles open-weight) ---
# Groq : https://console.groq.com/keys
GROQ_API_KEY=
# NVIDIA : https://build.nvidia.com
NVIDIA_API_KEY=
# OpenRouter : https://openrouter.ai/keys (modèles « :free »)
OPENROUTER_API_KEY=
# Hugging Face : https://huggingface.co/settings/tokens
HF_TOKEN=

# Modèle de l'assistant, sous la forme fournisseur:modèle
MODELE_PAR_DEFAUT=groq:openai/gpt-oss-20b

# --- Observabilité LangSmith (facultatif) : https://smith.langchain.com ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=assistant-fictiva
# Compte hébergé en Europe :
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Réglages du service ---
RERANKING=true
NOMBRE_EXTRAITS=4
ORIGINES_CORS=http://localhost:3000
# DOSSIER_DONNEES=../donnees
# CACHE_MODELES=.cache_modeles
