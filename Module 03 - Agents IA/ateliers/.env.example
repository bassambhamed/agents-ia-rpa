# Par défaut, les ateliers lisent le .env commun, à la racine de la formation (modèle :
# .env.example à la racine). Ce fichier ne sert que si vous utilisez ce dossier seul :
# un .env placé ici l'emporte sur le .env commun.
#
# Copiez ce fichier en .env, puis renseignez au moins une clé.
# Le fichier .env ne doit jamais être partagé ni versionné.

# Groq : https://console.groq.com/keys (palier gratuit, quotas par minute et par jour)
GROQ_API_KEY=
# NVIDIA : https://build.nvidia.com (gratuit pour le prototypage, débit limité)
NVIDIA_API_KEY=
# OpenRouter : https://openrouter.ai/keys (modèles « :free », 50 requêtes par jour sans crédit acheté)
OPENROUTER_API_KEY=
# Hugging Face : https://huggingface.co/settings/tokens (crédits PRO ou achetés)
HF_TOKEN=

# Modèle utilisé par défaut dans les ateliers, sous la forme fournisseur:modèle
MODELE_PAR_DEFAUT=groq:openai/gpt-oss-20b

# Langfuse (atelier 3.D, facultatif) : https://cloud.langfuse.com, offre gratuite « Hobby »
# ou instance auto-hébergée. Sans ces clés, l'atelier utilise un traceur local.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
